{
  "manifest_version": 3,
  "name": "PearPlay",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "description": "Explicit video URL handoff to a user-selected AirPlay receiver through a local helper.",
  "permissions": ["activeTab", "scripting", "webRequest", "webNavigation", "nativeMessaging", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "PearPlay"}
}
